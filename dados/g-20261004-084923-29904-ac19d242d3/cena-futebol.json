 "etapas": [
  {
   "de": 0,
   "ate": 57,
   "titulo": "Drible",
   "texto": "Giro com a bola: cada toque sai da posição real do pé."
  },
  {
   "de": 57,
   "ate": 133,
   "titulo": "Chute",
   "texto": "O último toque levanta a bola e o chute pega de voleio. A câmera acompanha a perna no ponto mais alto."
  },
  {
   "de": 133,
   "ate": 246,
   "titulo": "Pouso da perna de apoio",
   "texto": "A dor aparece no pouso. Em destaque, músculos e ligamentos da parte de trás do joelho e da coxa."
  },
  {
   "de": 246,
   "ate": 464,
   "titulo": "Avaliação",
   "texto": "Na maca, a parte de trás da coxa e do joelho é examinada. A cena não indica diagnóstico."
  },
  {
   "de": 464,
   "ate": 772,
   "titulo": "Reabilitação",
   "texto": "Agachamento, salto na caixa e flexão com salto: sequência ilustrativa, não prescrição."
  },
  {
   "de": 772,
   "ate": 832,
   "titulo": "Reavaliação",
   "texto": "Nova avaliação antes de voltar ao campo."
  },
  {
   "de": 832,
   "ate": 960,
   "titulo": "Retorno",
   "texto": "Drible e chute de novo, sem dor."
  },
  {
   "de": 960,
   "ate": 1172,
   "titulo": "Comemoração",
   "texto": "Corrida de braços erguidos, estrela e mortal para trás."
