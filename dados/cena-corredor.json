 "etapas": [
  {
   "de": 0,
   "ate": 66,
   "titulo": "Largada",
   "texto": "Pés nos pedais do bloco, mãos atrás da linha. Na prova de 400 m com barreiras masculina adulta são dez barreiras de 0,914 m."
  },
  {
   "de": 66,
   "ate": 163,
   "titulo": "Aproximação",
   "texto": "Na prova, a primeira barreira fica a 45 m da largada. A cena encurta essa distância (decisão do modelo, não medida da prova)."
  },
  {
   "de": 163,
   "ate": 191,
   "titulo": "Transposição",
   "texto": "Perna de ataque à frente, perna de arrasto passando por cima da barreira."
  },
  {
   "de": 191,
   "ate": 288,
   "titulo": "Aterrissagem e queda",
   "texto": "A queda vem depois do pouso. A cena mostra o movimento; não indica a causa."
  },
  {
   "de": 324,
   "ate": 470,
   "titulo": "No banco",
   "texto": "Mão sobre o joelho, perna estendida. Em destaque, ossos, meniscos e ligamentos do joelho desse lado."
  },
  {
   "de": 494,
   "ate": 715,
   "titulo": "Avaliação",
   "texto": "Deitado na maca, o joelho é examinado. Só a avaliação presencial define o que aconteceu."
  },
  {
   "de": 715,
   "ate": 1137,
   "titulo": "Reabilitação",
   "texto": "Agachamento, agachamento com pernas alternadas e agachamento com peso à frente: sequência ilustrativa, não prescrição."
  },
  {
   "de": 1137,
   "ate": 1197,
   "titulo": "Reavaliação",
   "texto": "Nova avaliação antes de voltar à pista."
  },
  {
   "de": 1197,
   "ate": 1325,
   "titulo": "Retorno",
   "texto": "De volta à corrida, a barreira passa limpa."
  },
  {
   "de": 1325,
   "ate": 1575,
   "titulo": "Comemoração",
   "texto": "Salto com o punho erguido e palmas."
  }
